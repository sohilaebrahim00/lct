# AI Concierge (netlify/functions/ai-concierge.js) — server-side only.
# Set the real value in the Netlify dashboard: Site configuration →
# Environment variables. Never commit a real key to this file or anywhere
# else in the repo; this file only documents the variable name.
GEMINI_API_KEY=
# Optional model overrides (defaults: gemini-3.6-flash, then gemini-flash-latest):
# GEMINI_MODEL=
# GEMINI_MODEL_FALLBACK=

# Lead email notifications (netlify/functions/lead-notify.js and
# lead-notify-sweep.js) — server-side only, same rule: real values live in
# Netlify's environment variables, never here and never in VITE_* variables.
# Supabase secret key (Project Settings → API keys), used only to read the
# stored lead and update its notification status:
SUPABASE_SERVICE_ROLE_KEY=
# Mailbox that sends the notification (Namecheap Private Email):
SMTP_USER=
SMTP_PASS=
# Optional (defaults shown):
# SMTP_HOST=mail.privateemail.com
# SMTP_PORT=465
# LEAD_NOTIFY_TO=reservations@lctuniversal.com
# LEAD_NOTIFY_SINCE=2026-10-16T13:00:00Z
# LEAD_NOTIFY_MAX_PER_HOUR=60
# RESEND_API_KEY=   (optional second transport, used if SMTP fails)
